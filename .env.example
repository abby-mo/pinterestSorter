# Copy this file to .env and fill in the values.
# See README.md -> "Pinterest API setup" for how to get these.

# --- Pinterest Developer App ---------------------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Must EXACTLY match a redirect URI registered on your Pinterest app.
# The Vite dev server proxies /api to the backend, so this is port 5173.
PINTEREST_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Pinterest API base URL. Leave as-is unless you know you need the sandbox.
PINTEREST_API_BASE=https://api.pinterest.com/v5

# --- App behaviour --------------------------------------------------------
# Start in demo mode with sample pins (no Pinterest account needed).
# The in-app "Demo mode" toggle overrides this once you use it.
MOCK_MODE=true

# How long a save waits before it is sent to Pinterest (milliseconds).
# Undo within this window cancels the save without touching Pinterest.
SAVE_DELAY_MS=5000

# How "Save" copies a pin to your destination board:
#   auto   - try Pinterest's re-pin endpoint, fall back to creating a copy
#   save   - re-pin endpoint only (POST /v5/pins/{id}/save)
#   create - always create a new pin with the same image + link (POST /v5/pins)
SAVE_STRATEGY=auto

# Demo mode only: fraction of saves that fail on purpose, to exercise retries.
MOCK_FAILURE_RATE=0.08

# Where tokens and progress are stored (relative to the project root).
# This repo lives in OneDrive, so consider a path outside it, e.g.
# DATA_DIR=C:/Users/you/AppData/Local/pin-sorter
DATA_DIR=data

# Backend port (the Vite proxy expects 3001).
API_PORT=3001
